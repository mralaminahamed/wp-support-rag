# WP Plugin Support Desk RAG — environment template.
# Copy to `.env` and fill secrets. All keys are optional in development;
# defaults live in app/config.py. Prefix is WPRAG_.

# --- Service ---
WPRAG_ENVIRONMENT=development
WPRAG_LOG_LEVEL=INFO

# --- Datastores ---
WPRAG_DATABASE_DSN=postgresql+asyncpg://wprag:wprag@localhost:5432/wprag
WPRAG_REDIS_DSN=redis://localhost:6379/0

# --- LLM Providers ---
# Set DEFAULT_PROVIDER to: anthropic | openai | gemini | opencode_zen | ollama
# Active provider/model can be overridden at runtime from the admin Settings page.
WPRAG_DEFAULT_PROVIDER=anthropic

# Anthropic (Claude) — https://console.anthropic.com/settings/keys
WPRAG_ANTHROPIC_API_KEY=
WPRAG_ANTHROPIC_MODEL=claude-sonnet-4-6
# Other models: claude-opus-4-8, claude-haiku-4-5-20251001, claude-3-5-sonnet-20241022

# OpenAI — https://platform.openai.com/api-keys
WPRAG_OPENAI_API_KEY=
WPRAG_OPENAI_MODEL=gpt-4o-mini
# Other models: gpt-4o, gpt-4-turbo, gpt-4, gpt-3.5-turbo

# Google Gemini — https://aistudio.google.com/apikey
WPRAG_GEMINI_API_KEY=
WPRAG_GEMINI_MODEL=gemini-2.0-flash
# Other models: gemini-2.0-flash-lite, gemini-1.5-pro, gemini-1.5-flash

# OpenCode Zen — https://opencode.ai/zen
WPRAG_OPENCODE_ZEN_API_KEY=
WPRAG_OPENCODE_ZEN_MODEL=opencode/claude-sonnet-4-6
# Other models: opencode/gpt-5.5, opencode/gemini-3.5-flash, opencode/deepseek-v4-flash-free

# Ollama (local) — https://ollama.com
WPRAG_OLLAMA_BASE_URL=http://localhost:11434
WPRAG_OLLAMA_MODEL=llama3.2

# --- Embedding / dimensionality (ADR-002) ---
# embedding_provider selects the backend. 'openai' uses text-embedding-3-large at
# the dimensionality_mode width; 'ollama' embeds fully-locally at the model's
# native width. The dimension is bound to the DB column + HNSW index, so changing
# provider/width requires 'alembic upgrade head' and a full re-ingest — it is NOT
# a runtime toggle (the Settings page rejects width changes).
WPRAG_EMBEDDING_PROVIDER=openai
WPRAG_EMBED_MODEL=text-embedding-3-large
WPRAG_DIMENSIONALITY_MODE=halfvec_3072
WPRAG_OLLAMA_EMBED_MODEL=nomic-embed-text
WPRAG_OLLAMA_EMBED_DIMENSIONS=768

# --- Ingestion (§2.2, FR-IN-*) ---
# GitHub personal access token. Raises the API rate limit and grants access to
# private plugin repos; without it, those sources fail with HTTP 403 during
# ingestion. Scope: 'repo' (private) or 'public_repo' (public only).
WPRAG_GITHUB_TOKEN=

# --- Auth ---
# Generate JWT secret with: openssl rand -hex 32
WPRAG_JWT_SECRET=
# First-boot admin account (only used when users table is empty)
WPRAG_BOOTSTRAP_EMAIL=admin@example.com
WPRAG_BOOTSTRAP_PASSWORD=
WPRAG_ALLOW_REGISTRATION=false
WPRAG_ADMIN_URL=http://localhost:8081
WPRAG_CORS_ORIGINS=["*"]
# Regex matched against Origin header — allows entire subnets without listing every IP.
# Default allows any http 192.168.x.x device on any port (dev LAN access).
WPRAG_CORS_ORIGIN_REGEX=http://192\.168\.\d+\.\d+(:\d+)?
